      }
    },
    "扩展主题": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension Theme"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能のテーマ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展主题"
          }
        }
      }
    },
    "扩展在 hub 的管理界面（/admin）或 hub 所在的机器上用 personad extension install 安装，装好后在这里开关和设置。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Install extensions in the hub's admin page (/admin) or on the hub machine with personad extension install, then turn them on and set them up here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能はハブの管理画面（/admin）か、ハブのマシンでpersonad extension installを使ってインストールします。インストール後、ここでオン/オフや設定ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展在 hub 的管理界面（/admin）或 hub 所在的机器上用 personad extension install 安装，装好后在这里开关和设置。"
          }
        }
      }
    },
    "扩展在 hub 的管理界面（/admin）或 hub 所在的机器上（personad extension）安装、升级和卸载，这里可以开关、改设置、填密钥。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensions are installed, updated and uninstalled in the hub's admin page (/admin) or on the hub machine (personad extension). Here you can turn them on or off, change settings and enter secrets."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能のインストール、アップデート、アンインストールはハブの管理画面（/admin）かハブのマシン（personad extension）で行います。ここではオン/オフ、設定の変更、シークレットの入力ができます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展在 hub 的管理界面（/admin）或 hub 所在的机器上（personad extension）安装、升级和卸载，这里可以开关、改设置、填密钥。"
          }
        }
      }
    },
    "扩展市场": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extension Market"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能マーケット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展市场"
          }
        }
      }
    },
    "扩展市场是一个仓库或网站发布的扩展索引。添加一个市场后，这里列出它的扩展，可以直接安装。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "An extension market is an index of extensions published by a repository or website. Add one to list its extensions here and install them directly."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能マーケットは、リポジトリやWebサイトが公開する拡張機能の一覧です。マーケットを追加すると、ここにその拡張機能が表示され、直接インストールできます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展市场是一个仓库或网站发布的扩展索引。添加一个市场后，这里列出它的扩展，可以直接安装。"
          }
        }
      }
    },
    "扩展市场里出了新版本，扩展空闲时自动装上；新版本要的权限变多时先问你。装上后起不来的会退回原来的版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "When the market has a new version, it installs while the extension is idle, and asks you first if it wants more permissions. If it doesn't start after installing, it goes back to the previous version."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "マーケットに新しいバージョンが出ると、拡張機能がアイドルのときに自動でインストールします。必要な権限が増える場合は先に確認します。インストール後に起動しない場合は元のバージョンに戻します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展市场里出了新版本，扩展空闲时自动装上；新版本要的权限变多时先问你。装上后起不来的会退回原来的版本。"
          }
        }
      }
    },
    "扩展市场里提供渠道的扩展：装好后在这里绑定。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Extensions in the extension market that add channels. Install one, then bind it here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能マーケットにあるチャネルを提供する拡張機能です。インストール後にここで紐づけます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展市场里提供渠道的扩展：装好后在这里绑定。"
          }
        }
      }
    },
    "扩展开着时不自动锁屏": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Don't Auto-Lock While On"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "有効中は自動ロックしない"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展开着时不自动锁屏"
          }
        }
      }
    },
    "扩展拿不到 App Group 容器（签名里没有这个组）：画的是默认形象换成它的颜色": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extension can't get the App Group container (the group isn't in its signature): it draws the default avatar in the pack's colors"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能がApp Groupのコンテナを取得できません（署名にこのグループがありません）。既定のアバターをその色で描画しています"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展拿不到 App Group 容器（签名里没有这个组）：画的是默认形象换成它的颜色"
          }
        }
      }
    },
    "扩展按预览列出的权限和 hub 的隔离配置运行。包已按市场给的校验和核对过。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extension runs with the permissions listed in the preview and the hub's isolation settings. The package was verified against the market's checksum."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能はプレビューに記載された権限とハブの分離設定で実行されます。パッケージはマーケットのチェックサムで検証済みです。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展按预览列出的权限和 hub 的隔离配置运行。包已按市场给的校验和核对过。"
          }
        }
      }
    },
