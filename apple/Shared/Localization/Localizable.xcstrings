    "Persona 能搜消息、读文档；发消息等写操作先在 App 里问你": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona can search messages and read docs; sending messages and other changes ask you in the app first"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Personaはメッセージの検索やドキュメントの閲覧ができます。メッセージ送信などの書き込みは先にAppで確認します"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "Persona 能搜消息、读文档；发消息等写操作先在 App 里问你"
          }
        }
