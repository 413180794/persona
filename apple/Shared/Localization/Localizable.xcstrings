    "通讯录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Contacts"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通讯录"
          }
        }
      }
    },
    "通讯录里的人和你回复过的会话会进知识库和收件箱（和飞书一样分拣），助手能查、能总结；验证码会打码。关掉立刻停止；要删 hub 上已存的，先关掉。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Conversations with your contacts and ones you've replied to go into the knowledge base and Inbox (sorted like Lark), where the assistant can search and summarize them. Verification codes are masked. Turning this off stops it right away; to delete what's stored on the hub, turn it off first."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "連絡先の人や返信したことのある会話はナレッジと受信トレイに入り（Larkと同じく仕分けされます）、アシスタントが検索・要約できます。確認コードは伏せ字になります。オフにするとすぐに停止します。ハブに保存済みのデータを削除するには、先にオフにしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "通讯录里的人和你回复过的会话会进知识库和收件箱（和飞书一样分拣），助手能查、能总结；验证码会打码。关掉立刻停止；要删 hub 上已存的，先关掉。"
          }
        }
      }
    },
    "速度": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Speed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "速度"
          }
        },
        "zh-Hans": {
