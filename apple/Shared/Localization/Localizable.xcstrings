          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "“%1$@” will be removed from the list on all your devices. Its chat history on %2$@ won't be deleted; continue it on the computer with %3$@ and it'll come back."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%1$@」はすべてのデバイスのリストから削除されます。%2$@上のチャット履歴は削除されません。あとでコンピューターで%3$@を使って続けると、再び表示されます。"
          }
        }
      }
    },
