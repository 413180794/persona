        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在飞书里对文档发表的评论会出现在这里"
          }
        }
      }
    },
    "在飞书里把这串数字发给机器人": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Send this number to the bot in Lark"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
