    "扩展上次画的不是设置里的形象（还没重画过）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The extension last drew a different avatar than Settings (not redrawn yet)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "拡張機能が前回描画したアバターは設定と異なります（まだ再描画されていません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "扩展上次画的不是设置里的形象（还没重画过）"
          }
