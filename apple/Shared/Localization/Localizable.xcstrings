          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在飞书打开"
          }
        }
      }
    },
    "在飞书里对文档发表的评论会出现在这里": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Comments on this doc in Lark show up here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Larkでこのドキュメントに付いたコメントがここに表示されます。"
          }
