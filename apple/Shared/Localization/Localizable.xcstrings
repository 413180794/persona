    "设备码登录": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device Code Sign-In"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスコードでサインイン"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备码登录"
          }
        }
      }
    },
    "设备码登录少了 %@ 权限：先换成别的登录方式，再用设备码重新登录一次。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device code sign-in is missing the %@ scope: switch to another sign-in method, then sign in with a device code again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスコードのサインインに%@の権限がありません。別のサインイン方法に切り替えてから、もう一度デバイスコードでサインインしてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备码登录少了 %@ 权限：先换成别的登录方式，再用设备码重新登录一次。"
          }
        }
      }
    },
    "设备码登录的授权加密存在 hub 上；改用电脑上的 gh 登录时会忘掉。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Device-code authorization is stored encrypted on the hub; it's forgotten when you switch to gh on a computer."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "デバイスコードでの認可は暗号化してハブに保存されます。コンピューターのghに切り替えると破棄されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "设备码登录的授权加密存在 hub 上；改用电脑上的 gh 登录时会忘掉。"
          }
        }
      }
    },
