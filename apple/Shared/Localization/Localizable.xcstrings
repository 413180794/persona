      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld linked hub in this group; you see the whole group's machines. If the connected one drops, another in the group takes over. "
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "%lld linked hubs in this group; you see the whole group's machines. If the connected one drops, another in the group takes over. "
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "グループ内の%lld台のハブが連携しており、グループ全体のマシンが表示されます。接続中のハブが切れると、グループ内の別のハブに切り替わります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
