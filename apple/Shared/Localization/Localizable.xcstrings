          }
        }
      }
    },
    "音频只留在本机，手表录音会回传这里。本机转写后文字自动同步到知识库，保留最近 %lld 天，助手和 Agent 用知识库搜索就能找到。": {
      "localizations": {
        "en": {
          "variations": {
            "plural": {
              "one": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Audio stays on this device; watch recordings come back here. After on-device transcription the text syncs to Knowledge automatically and is kept for the last %lld day, so the Assistant and agents can find it with a Knowledge search."
                }
              },
              "other": {
                "stringUnit": {
                  "state": "translated",
                  "value": "Audio stays on this device; watch recordings come back here. After on-device transcription the text syncs to Knowledge automatically and is kept for the last %lld days, so the Assistant and agents can find it with a Knowledge search."
                }
              }
            }
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "音声はこのデバイスにのみ残り、Apple Watchの録音はここに戻ります。デバイス上で文字起こしした後、文字は自動でナレッジに同期され、直近%lld日分が保存されます。アシスタントとエージェントはナレッジ検索で見つけられます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "音频只留在本机，手表录音会回传这里。本机转写后文字自动同步到知识库，保留最近 %lld 天，助手和 Agent 用知识库搜索就能找到。"
          }
        }
      }
    },
