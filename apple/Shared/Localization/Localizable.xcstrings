          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "在飞书开放平台建一个企业自建应用，开启「机器人」能力"
          }
        }
      }
    },
    "在飞书打开": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Open in Lark"
          }
        },
        "ja": {
          "stringUnit": {
