          }
        }
      }
    },
    "飞书账号在 hub 所在机器的飞书网关里登录，会话与收件箱共用这个账号，无需再次登录。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Lark account is signed in through the Lark gateway on the hub machine. Chats share this account with the Inbox, so there's no need to sign in again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "LarkアカウントはハブのマシンのLarkゲートウェイでログインします。チャットは受信トレイとこのアカウントを共有するため、再ログインは不要です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "飞书账号在 hub 所在机器的飞书网关里登录，会话与收件箱共用这个账号，无需再次登录。"
          }
        }
      }
    },
    "飞书账号已切换": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lark account changed"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Larkアカウントが切り替わりました"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "飞书账号已切换"
          }
        }
      }
    },
    "飞书账号已切换，原消息未发送。请切回原账号后重试": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Your Lark account changed, so the message wasn't sent. Switch back to the original account and try again."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Larkアカウントが切り替わったため、メッセージは送信されていません。元のアカウントに戻してから再試行してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "飞书账号已切换，原消息未发送。请切回原账号后重试"
          }
        }
      }
    },
    "飞书账号已切换，草稿按账号分别保留": {
      "localizations": {
        "en": {
