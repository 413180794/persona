      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Say “log my weight” or “I drank 300 ml of water”; after you confirm on the phone it's saved to Health."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「体重を記録して」「水を300ml飲んだ」と伝えると、iPhoneで確認後にヘルスケアに書き込みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "说「记一下体重」「喝了 300 毫升水」，手机上确认后写进健康。"
