          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康"
          }
        }
      }
    },
    "健康对话": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Chats"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアのチャット"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康对话"
          }
        }
      }
    },
    "健康对话只在这里：Persona 的其他对话看不到、读不到。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health chats stay here: Persona's other chats can't see or read them."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアのチャットはここだけのものです。Personaの他のチャットからは見えず、読み取れません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康对话只在这里：Persona 的其他对话看不到、读不到。"
          }
        }
      }
    },
    "健康对话里记下的事，只有健康对话会读，Persona 的其他对话看不到。说错的地方可以直接改，或者在健康对话里告诉它。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "What's noted in health chats is read only by health chats; Persona's other chats can't see it. Fix anything wrong right here, or tell it in a health chat."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアのチャットで記録した内容はヘルスケアのチャットだけが読み、Personaの他のチャットからは見えません。誤りはここで直接修正するか、ヘルスケアのチャットで伝えてください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康对话里记下的事，只有健康对话会读，Persona 的其他对话看不到。说错的地方可以直接改，或者在健康对话里告诉它。"
          }
        }
      }
    },
    "健康对话里记下的目标、过敏、用药等会出现在这里。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals, allergies, medications and more noted in health chats appear here."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアのチャットで記録した目標、アレルギー、服薬などがここに表示されます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康对话里记下的目标、过敏、用药等会出现在这里。"
          }
        }
      }
    },
    "健康对话里记下的目标、过敏、用药等，单独存放，不会流到其他对话；可以随时查看和删除。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Goals, allergies, medications and other things noted in health chats are kept separately and never flow into other chats. You can view and delete them anytime."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアのチャットで記録した目標、アレルギー、服薬などは別に保存され、他のチャットには渡りません。いつでも確認・削除できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康对话里记下的目标、过敏、用药等，单独存放，不会流到其他对话；可以随时查看和删除。"
          }
        }
      }
    },
    "健康记忆": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Memory"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアのメモリ"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康记忆"
          }
        }
      }
    },
    "健康趋势": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Health Trends"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ヘルスケアの傾向"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "健康趋势"
          }
        }
      }
    },
    "像在对话里一样写：看哪些数据、怎么汇报。它可以用 schedule_followup 再安排一次性的跟进，比如会前 10 分钟。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Write it as you would in a chat: what to look at and how to report. It can use schedule_followup to set up one-time follow-ups, like 10 minutes before a meeting."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "チャットと同じように書きます。何を見て、どう報告するか。schedule_followupで1回きりのフォローアップ（会議の10分前など）も予約できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "像在对话里一样写：看哪些数据、怎么汇报。它可以用 schedule_followup 再安排一次性的跟进，比如会前 10 分钟。"
          }
        }
      }
    },
