          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "このサイトはこのMacのego liteでログアウトされます。ego上でのご自身のログインも同様です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "这个网站在这台 Mac 的 ego lite 里会退出登录。你自己在 ego 里的登录也一样。"
          }
