    "%@ %@": {
      "comment": "A day and a time of day\nDate and 24-hour time, e.g. Nov 2 09:00\nRepeat rule and time of day, e.g. Every weekday 9:00 AM",
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "new",
            "value": "%1$@ %2$@"
          }
        }
      },
      "shouldTranslate": false
    },
    "%@ %@\n\n在服务器上运行 ssh-keygen -lf 查看它的主机公钥，指纹一致再信任。之后指纹变了会拒绝连接。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@\n\n在服务器上运行 ssh-keygen -lf 查看它的主机公钥，指纹一致再信任。之后指纹变了会拒绝连接。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@\\n\\nOn the server, run ssh-keygen -lf on its host public key and trust it only if the fingerprints match. If the fingerprint changes later, the connection is refused."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@ %2$@\\n\\nサーバーでssh-keygen -lfを実行してホスト公開鍵を確認し、フィンガープリントが一致したら信頼してください。今後フィンガープリントが変わると接続を拒否します。"
          }
        }
      }
    },
    "%@ %@ · %@": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
