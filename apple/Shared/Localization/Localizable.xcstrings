      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "After a temporary model service error (503 and the like), sends “continue” automatically, up to 3 times"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "モデルサービスの一時的なエラー（503など）の後、自動で「続けて」を送信します（最大3回）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "模型服务临时出错（503 等）后自动发「继续」，最多 3 次"
          }
        }
      }
    },
