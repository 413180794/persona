            "state": "translated",
            "value": "hub 不认这台设备的凭据（401）"
          }
        }
      }
    },
    "hub 不让连这台的屏幕（扩展没开，或这台设备只能看不能操作）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hub won't connect to this screen (the extension is off, or this device can view but not control)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハブがこの画面への接続を許可していません（拡張機能がオフか、このデバイスは表示のみで操作できません）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hub 不让连这台的屏幕（扩展没开，或这台设备只能看不能操作）"
          }
        }
      }
    },
    "hub 会在空闲时自动更新": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hub updates itself when idle"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハブはアイドル時に自動で更新されます"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hub 会在空闲时自动更新"
          }
        }
      }
    },
    "hub 会把飞书和邮件里的会话归档、压缩，自动整理出项目、人、文档和会议，并按重要级和相关性排好。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hub archives and condenses your Lark and email conversations, organizes them into projects, people, docs and meetings, and ranks them by importance and relevance."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハブがLarkとメールの会話をアーカイブ・要約し、プロジェクト、人、ドキュメント、会議に自動で整理して、重要度と関連度で並べます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hub 会把飞书和邮件里的会话归档、压缩，自动整理出项目、人、文档和会议，并按重要级和相关性排好。"
          }
        }
      }
    },
    "hub 在下载、校验、解包并启动它，大的扩展要一两分钟。可以先离开这一页，回来还能看到。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hub is downloading, verifying, unpacking and starting it; a large extension takes a minute or two. You can leave this page and come back to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hubがダウンロード、検証、展開、起動を行っています。大きな拡張機能は1〜2分かかります。このページを離れても、戻れば確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hub 在下载、校验、解包并启动它，大的扩展要一两分钟。可以先离开这一页，回来还能看到。"
          }
        }
      }
    },
    "hub 在停下它、删掉它的文件和数据。可以先离开这一页，回来还能看到。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The hub is stopping it and deleting its files and data. You can leave this page and come back to it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "hubが停止し、ファイルとデータを削除しています。このページを離れても、戻れば確認できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "hub 在停下它、删掉它的文件和数据。可以先离开这一页，回来还能看到。"
          }
        }
      }
    },
