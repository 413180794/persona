    "飞书邮箱": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lark Mail"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Larkメール"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "飞书邮箱"
          }
        }
      }
    },
    "飞书邮箱：服务器固定为 imap.larkoffice.com:993、smtp.larkoffice.com:465（SSL），只填邮箱和密码。密码是飞书邮箱设置里的「第三方客户端登录密码」。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Lark Mail: the servers are always imap.larkoffice.com:993 and smtp.larkoffice.com:465 (SSL), so just enter your address and password. Use the third-party client password from your Lark Mail settings."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Larkメール：サーバーはimap.larkoffice.com:993とsmtp.larkoffice.com:465（SSL）に固定されているため、メールアドレスとパスワードだけを入力してください。パスワードはLarkメールの設定にある「サードパーティクライアント用パスワード」です。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "飞书邮箱：服务器固定为 imap.larkoffice.com:993、smtp.larkoffice.com:465（SSL），只填邮箱和密码。密码是飞书邮箱设置里的「第三方客户端登录密码」。"
          }
        }
      }
    },
