      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The Home Screen icon can only use the few built into the app. Avatars from the hub or extensions apply fully in the app, while the icon uses the built-in avatar they name, or the default if they name none."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ホーム画面のアイコンはアプリに内蔵された数種類のみ使えます。ハブや拡張機能のアバターはアプリ内ではすべて反映され、アイコンは指定された内蔵アバターのもの、指定がなければデフォルトを使います。"
          }
        },
        "zh-Hans": {
