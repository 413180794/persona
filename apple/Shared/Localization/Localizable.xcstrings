    "连不上 %@:%@（%@）。检查地址和端口，以及这台设备能不能访问它。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连不上 %1$@:%2$@（%3$@）。检查地址和端口，以及这台设备能不能访问它。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach %1$@:%2$@ (%3$@). Check the address and port, and whether this device can reach it."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "%1$@:%2$@に接続できません（%3$@）。アドレスとポート、このデバイスからアクセスできるかを確認してください。"
          }
        }
      }
    },
    "连不上 hub": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the hub"
          }
        },
        "ja": {
