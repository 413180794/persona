    },
    "点「一键解锁」，验证后把记住的密码输入它的锁屏。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap One-Tap Unlock; after you verify, the saved password is typed on its lock screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ワンタップでロック解除」をタップすると、認証後に保存したパスワードをロック画面に入力します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「一键解锁」，验证后把记住的密码输入它的锁屏。"
          }
        }
      }
    },
    "点「打开 ego lite」，它会在那台 Mac 上打开（屏幕共享开着时可以用「VNC」在手机上操作）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Open ego lite and it opens on that Mac (with Screen Sharing on, you can use VNC to work on it from your phone)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ego liteを開く」をタップすると、そのMacで開きます（画面共有がオンなら「VNC」でスマートフォンから操作できます）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「打开 ego lite」，它会在那台 Mac 上打开（屏幕共享开着时可以用「VNC」在手机上操作）"
          }
        }
      }
    },
    "点「解锁」打开它的画面，切到「接管」，在锁屏上输那台 Mac 的登录密码。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Unlock to open its screen, switch to Take Over, and type that Mac's login password on the lock screen."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ロック解除」をタップして画面を開き、「操作」に切り替えて、ロック画面にそのMacのログインパスワードを入力してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「解锁」打开它的画面，切到「接管」，在锁屏上输那台 Mac 的登录密码。"
          }
        }
      }
    },
    "点「配对」拿一个 6 位数字，10 分钟内在飞书里发给机器人。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Pair to get a 6-digit number, then send it to the bot in Lark within 10 minutes."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「ペアリング」をタップして6桁の数字を取得し、10分以内にLarkでボットに送信してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点「配对」拿一个 6 位数字，10 分钟内在飞书里发给机器人。"
          }
        }
      }
    },
    "点一下标注后再发": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click to mark up before sending"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックして注釈を付けてから送信"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下标注后再发"
          }
        }
      }
    },
    "点一下终端就能直接打字，每个键发到终端（输入法也能用），⌘ 组合键留给 App；键栏的键盘按钮把输入移到终端或移开，双击它是回车。点终端同时是点在终端里（比如 Claude 的「Jump to bottom」）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the terminal to type directly: every key goes to the terminal (input methods work too), and ⌘ shortcuts stay with the app. The key bar's keyboard button moves input to or away from the terminal; double-click it for Return. A click on the terminal is also a click inside it (such as Claude's “Jump to bottom”)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルをクリックすると直接入力でき、すべてのキーがターミナルに送られます（入力方式も使えます）。⌘のショートカットはAppが使います。キーバーのキーボードボタンで入力先をターミナルに切り替え、ダブルクリックでReturnです。ターミナルのクリックはターミナル内のクリックにもなります（Claudeの「Jump to bottom」など）。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点一下终端就能直接打字，每个键发到终端（输入法也能用），⌘ 组合键留给 App；键栏的键盘按钮把输入移到终端或移开，双击它是回车。点终端同时是点在终端里（比如 Claude 的「Jump to bottom」）。"
          }
        }
      }
    },
    "点击消息下方的「已编辑」，查看已留存的旧版本。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap Edited under a message to see the earlier versions that were kept."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "メッセージの下の「編集済み」をタップすると、保存されている以前のバージョンを表示できます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点击消息下方的「已编辑」，查看已留存的旧版本。"
          }
        }
      }
    },
    "点右上角的 ＋，或者在对话里说「每天 9 点给我早报」「每 30 分钟巡检一次」，让 Persona 定时做一件事。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap ＋ at the top right, or say “give me a morning briefing at 9 every day” or “check in every 30 minutes” in a chat to have Persona do something on a schedule."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "右上の＋をタップするか、チャットで「毎日9時に朝のまとめを」「30分ごとに巡回して」と言うと、Personaが定期的に実行します。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点右上角的 ＋，或者在对话里说「每天 9 点给我早报」「每 30 分钟巡检一次」，让 Persona 定时做一件事。"
          }
        }
      }
    },
    "点底栏的剪贴板：「%@」把这边的文字放进 Mac 的剪贴板并粘贴；「%@」把 Mac 剪贴板里的文字拿过来。": {
      "localizations": {
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点底栏的剪贴板：「%1$@」把这边的文字放进 Mac 的剪贴板并粘贴；「%2$@」把 Mac 剪贴板里的文字拿过来。"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the clipboard in the bottom bar: “%1$@” puts your text on the Mac’s clipboard and pastes it; “%2$@” brings over the text on the Mac’s clipboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部バーのクリップボードをタップします。「%1$@」はこちらのテキストをMacのクリップボードに入れてペーストし、「%2$@」はMacのクリップボードのテキストを取り込みます。"
          }
        }
      }
    },
    "点底栏的键盘。键盘上面一排是 Mac 的快捷键：⌘ ⌥ ⌃ ⇧ 点一下按住、再点松开，还有 Esc、Tab、方向键和 ⌘C ⌘V ⌘Z ⌘Tab ⌘空格。中文照常输入，上屏的字经剪贴板粘贴过去。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the keyboard in the bottom bar. The row above the keyboard has Mac shortcuts: tap ⌘ ⌥ ⌃ ⇧ to hold, tap again to release, plus Esc, Tab, arrow keys, and ⌘C ⌘V ⌘Z ⌘Tab ⌘Space. Input methods such as Chinese work as usual; the committed text is pasted over through the clipboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "下部バーのキーボードをタップします。キーボードの上の列はMacのショートカットです。⌘ ⌥ ⌃ ⇧は1回タップで押したまま、もう一度タップで離します。Esc、Tab、矢印キー、⌘C ⌘V ⌘Z ⌘Tab ⌘スペースもあります。日本語入力もそのまま使え、確定した文字はクリップボード経由でペーストされます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点底栏的键盘。键盘上面一排是 Mac 的快捷键：⌘ ⌥ ⌃ ⇧ 点一下按住、再点松开，还有 Esc、Tab、方向键和 ⌘C ⌘V ⌘Z ⌘Tab ⌘空格。中文照常输入，上屏的字经剪贴板粘贴过去。"
          }
        }
      }
    },
    "点按就是左键；右键点按（或按住 Control 再点按）是右键；按住鼠标键不放再移动就是拖拽。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click for the left mouse button; right-click (or Control-click) for the right button; press and hold the mouse button and move to drag."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "クリックで左クリック、右クリック（またはControlを押しながらクリック）で右クリック、マウスボタンを押したまま動かすとドラッグになります。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点按就是左键；右键点按（或按住 Control 再点按）是右键；按住鼠标键不放再移动就是拖拽。"
          }
        }
      }
    },
    "点终端：开始打字，也是点在终端里（Claude 的「Jump to bottom」、顶上的提问）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Click the terminal: start typing; the click also goes to the terminal (Claude's “Jump to bottom”, questions at the top)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルをクリック：入力を開始し、ターミナル内のクリックにもなります（Claudeの「Jump to bottom」や上部の質問）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点终端：开始打字，也是点在终端里（Claude 的「Jump to bottom」、顶上的提问）"
          }
        }
      }
    },
    "点终端：点在终端里（Claude 的「Jump to bottom」、顶上的提问）": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the terminal: the tap goes to the terminal (Claude's “Jump to bottom”, questions at the top)"
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ターミナルをタップ：ターミナル内をタップ（Claudeの「Jump to bottom」や上部の質問）"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点终端：点在终端里（Claude 的「Jump to bottom」、顶上的提问）"
          }
        }
      }
    },
    "点键栏右边的键盘按钮弹出键盘，每个键直接发到终端（像在电脑上一样，输入法、听写都能用）；双击键盘按钮是回车。点终端是点在终端里（比如 Claude 的「Jump to bottom」），不会弹键盘。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Tap the keyboard button at the right of the key bar to show the keyboard; every key goes straight to the terminal (like on a computer, with input methods and dictation). Double-tap the keyboard button for Return. Tapping the terminal taps inside it (such as Claude's “Jump to bottom”) and doesn't show the keyboard."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "キーバー右端のキーボードボタンでキーボードを表示すると、すべてのキーがそのままターミナルに送られます（コンピューターと同じく、入力方式や音声入力も使えます）。キーボードボタンのダブルタップでReturnです。ターミナルのタップはターミナル内のタップになり（Claudeの「Jump to bottom」など）、キーボードは表示されません。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "点键栏右边的键盘按钮弹出键盘，每个键直接发到终端（像在电脑上一样，输入法、听写都能用）；双击键盘按钮是回车。点终端是点在终端里（比如 Claude 的「Jump to bottom」），不会弹键盘。"
          }
        }
      }
    },
