        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ego liteにはまだログイン済みのサイトがありません。別のコンピューターやブラウザから書き出したCookieファイルをインポートすると、アシスタントがあなたのログインでそれらのサイトを開けます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "ego lite 里还没有登录过的网站。导入另一台电脑或浏览器导出的 cookie 文件，助手就能用你的登录打开那些网站。"
          }
        }
