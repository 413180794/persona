    "浮层和卡片的画法、按钮、字体和对话里的组件，整个 App 一起换，包括收件箱里的飞书页面。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Changes how sheets, cards, buttons, fonts and chat components look across the whole app, including Lark pages in the Inbox."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "シート、カード、ボタン、フォント、チャット内のコンポーネントの見た目がアプリ全体で変わります。受信トレイのLarkページも含みます。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "浮层和卡片的画法、按钮、字体和对话里的组件，整个 App 一起换，包括收件箱里的飞书页面。"
          }
        }
      }
    },
