    "连接失败：%@。确认手机能访问这个地址（比如在同一个网络或 VPN 上），或者经 SSH 隧道连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect: %@. Make sure your phone can reach the address (for example, on the same network or VPN), or connect through an SSH tunnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できませんでした：%@。iPhoneからアドレスにアクセスできるか（同じネットワークやVPN上にあるかなど）を確認するか、SSHトンネル経由で接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败：%@。确认手机能访问这个地址（比如在同一个网络或 VPN 上），或者经 SSH 隧道连接。"
          }
        }
      }
    },
    "连接失败：%@。确认这台 Mac 能访问这个地址（比如在同一个网络或 VPN 上），或者经 SSH 隧道连接。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Couldn't connect: %@. Make sure this Mac can reach the address (for example, on the same network or VPN), or connect through an SSH tunnel."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "接続できませんでした：%@。このMacからアドレスにアクセスできるか（同じネットワークやVPN上にあるかなど）を確認するか、SSHトンネル経由で接続してください。"
          }
        },
        "zh-Hans": {
          "stringUnit": {
            "state": "translated",
            "value": "连接失败：%@。确认这台 Mac 能访问这个地址（比如在同一个网络或 VPN 上），或者经 SSH 隧道连接。"
          }
        }
      }
