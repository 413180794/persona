            "state": "translated",
            "value": "连不上 hub"
          }
        }
      }
    },
    "连不上 hub%@，确认手机能访问 hub（同一个网络或 VPN）。": {
      "localizations": {
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Can't reach the hub%@. Make sure your phone can reach it (same network or VPN)."
          }
        },
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "ハブに接続できません%@。iPhoneからハブにアクセスできるか確認してください（同じネットワークまたはVPN）。"
          }
        },
        "zh-Hans": {
