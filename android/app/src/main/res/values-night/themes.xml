<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Compose draws every screen itself; the dark theme matters for WebViews: pages in the link sheet are only
         darkened (algorithmic darkening) when the theme around them says it is not a light one. -->
    <style name="Theme.Jarvis" parent="android:Theme.Material.NoActionBar">
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:isLightTheme" tools:targetApi="q">false</item>
    </style>
</resources>
