{
  "name": "jarvis-site",
  "compatibility_date": "2026-10-01",
  "account_id": "2de3432934ff3b7c3cb742a2f09635a1",
  // Static files, except /relay/* (the push relay, docs/push-relay.md): worker.mjs forwards it.
  "main": "worker.mjs",
  "assets": { "directory": "public", "binding": "ASSETS", "html_handling": "auto-trailing-slash", "not_found_handling": "404-page",
              "run_worker_first": ["/relay/*"] },
  "routes": [{ "pattern": "jarvis.chirpet.com", "custom_domain": true }],
  "workers_dev": false
}
