{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "view.schema.json",
  "title": "Extension views",
  "description": "What an extension draws (ui.render, ui.action): a View of sections of components, drawn by every app with its own design system. Also the assistant's persona-card, which joins the components in #1850.",
  "$defs": {
    "Tone": {
      "description": "A role color the app picks, never one of the extension's own. An unknown tone draws as neutral.",
      "type": "string",
      "enum": ["neutral", "positive", "caution", "danger"]
    },
    "TextStyle": {"type": "string", "enum": ["body", "secondary", "caption", "code"]},
    "FieldKind": {"type": "string", "enum": ["text", "secret", "number", "toggle", "choice"]},
    "ChartKind": {"type": "string", "enum": ["bar", "line"]},
    "ButtonRole": {"type": "string", "enum": ["normal", "destructive"]},
    "Placement": {
      "description": "A slot in the apps an extension draws at (docs「UI 插槽」).",
      "type": "string",
      "enum": ["plugin_page", "launcher_section", "nav_page", "overview_card", "machine_section", "inbox_item"]
    },
    "Size": {"type": "string", "enum": ["compact", "full"]},
    "Platform": {"type": "string", "enum": ["ios", "mac", "android", "web"]},
    "NavIcon": {
      "description": "A nav_page's icon; each app draws its own for the meaning. An unknown icon draws as plugin.",
      "type": "string",
      "enum": ["plugin", "chart", "gauge", "list", "bell", "doc", "calendar", "money"]
    },
    "View": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "maxLength": 2000},
        "sections": {"type": "array", "items": {"$ref": "#/$defs/Section"}},
        "state": {"type": "string", "description": "The extension's own, sent back with the next render or action; at most 16 KB."},
        "refresh_after": {"type": "integer", "minimum": 0, "maximum": 86400, "x-since": 2,
          "description": "Draw again after this many seconds while on screen (30 at least; 0 never)."}
      },
      "required": ["sections"]
    },
    "Section": {
      "type": "object",
      "properties": {
        "title": {"type": "string", "maxLength": 2000},
        "footer": {"type": "string", "maxLength": 2000},
        "items": {"type": "array", "items": {"$ref": "#/$defs/Component"}}
      },
      "required": ["items"]
    },
    "Component": {
      "description": "One component of a view, told apart by type. A type an app does not know is skipped and the rest drawn.",
      "x-discriminator": "type",
      "oneOf": [
        {"$ref": "#/$defs/TextComponent"},
        {"$ref": "#/$defs/MetricComponent"},
        {"$ref": "#/$defs/ProgressComponent"},
        {"$ref": "#/$defs/RowComponent"},
        {"$ref": "#/$defs/ButtonComponent"},
        {"$ref": "#/$defs/LinkComponent"},
        {"$ref": "#/$defs/FieldComponent"},
        {"$ref": "#/$defs/DividerComponent"},
        {"$ref": "#/$defs/ChartComponent"},
        {"$ref": "#/$defs/StatGridComponent"},
        {"$ref": "#/$defs/SegmentedComponent"}
      ]
    },
    "TextComponent": {
      "description": "A paragraph.",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "text"},
        "text": {"type": "string", "minLength": 1, "maxLength": 2000},
        "style": {"$ref": "#/$defs/TextStyle"}
      },
      "required": ["type", "text"]
    },
    "MetricComponent": {
      "description": "A number with its label.",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "metric"},
        "label": {"type": "string", "minLength": 1, "maxLength": 2000},
        "value": {"type": "string", "minLength": 1, "maxLength": 2000},
        "detail": {"type": "string", "maxLength": 2000},
        "tone": {"$ref": "#/$defs/Tone"}
      },
      "required": ["type", "label", "value"]
    },
    "ProgressComponent": {
      "description": "A bar filled to ratio (0 to 1).",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "progress"},
        "label": {"type": "string", "minLength": 1, "maxLength": 2000},
        "ratio": {"type": "number", "minimum": 0, "maximum": 1, "x-go-pointer": true},
        "detail": {"type": "string", "maxLength": 2000},
        "tone": {"$ref": "#/$defs/Tone"}
      },
      "required": ["type", "label", "ratio"]
    },
    "RowComponent": {
      "description": "A row of a list; with an action it can be tapped.",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "row"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000},
        "subtitle": {"type": "string", "maxLength": 2000},
        "value": {"type": "string", "maxLength": 2000},
        "badge": {"$ref": "#/$defs/Badge"},
        "action": {"$ref": "#/$defs/Action"}
      },
      "required": ["type", "title"]
    },
    "ButtonComponent": {
      "description": "A button; its title never wraps.",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "button"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000},
        "action": {"$ref": "#/$defs/Action"},
        "role": {"$ref": "#/$defs/ButtonRole"}
      },
      "required": ["type", "title", "action"]
    },
    "LinkComponent": {
      "description": "A link the app opens inside itself: https only.",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "link"},
        "title": {"type": "string", "minLength": 1, "maxLength": 2000},
        "url": {"type": "string", "pattern": "^https://[^/?#]+"}
      },
      "required": ["type", "title", "url"]
    },
    "FieldComponent": {
      "description": "An input; its value goes back under name when an action submits. A secret is never filled in.",
      "type": "object", "x-since": 1,
      "properties": {
        "type": {"const": "field"},
        "name": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1, "maxLength": 2000},
        "kind": {"$ref": "#/$defs/FieldKind"},
        "value": {"type": "string", "maxLength": 2000},
        "choices": {"type": "array", "items": {"$ref": "#/$defs/Choice"}},
        "placeholder": {"type": "string", "maxLength": 2000}
      },
      "required": ["type", "name", "label", "kind"]
    },
    "DividerComponent": {
      "description": "A line between two groups of a section.",
      "type": "object", "x-since": 1,
      "properties": {"type": {"const": "divider"}},
      "required": ["type"]
    },
    "ChartComponent": {
      "description": "A bar or line chart. Every series has the same labels in the same order; with more than one series each is named.",
      "type": "object", "x-since": 2,
      "properties": {
        "type": {"const": "chart"},
        "kind": {"$ref": "#/$defs/ChartKind"},
        "series": {"type": "array", "minItems": 1, "maxItems": 4, "items": {"$ref": "#/$defs/ChartSeries"}},
        "title": {"type": "string", "maxLength": 2000},
        "unit": {"type": "string", "maxLength": 2000},
        "stacked": {"type": "boolean"},
        "detail": {"type": "string", "maxLength": 2000}
      },
      "required": ["type", "kind", "series"]
    },
    "StatGridComponent": {
      "description": "A few numbers side by side.",
      "type": "object", "x-since": 2,
      "properties": {
        "type": {"const": "stat_grid"},
        "stats": {"type": "array", "minItems": 1, "maxItems": 6, "items": {"$ref": "#/$defs/Stat"}}
      },
      "required": ["type", "stats"]
    },
    "SegmentedComponent": {
      "description": "One of a few, chosen at once: its action goes with values {name: the chosen value}.",
      "type": "object", "x-since": 2,
      "properties": {
        "type": {"const": "segmented"},
        "name": {"type": "string", "minLength": 1},
        "choices": {"type": "array", "minItems": 2, "maxItems": 5, "items": {"$ref": "#/$defs/Choice"}},
        "value": {"type": "string"},
        "action": {"$ref": "#/$defs/Action"}
      },
      "required": ["type", "name", "choices", "value", "action"]
    },
    "Action": {
      "description": "What a row, a button or a segmented does: ui.action with its id. An object, so later kinds of action (push or pop a page) are fields added here.",
      "type": "object",
      "properties": {
        "id": {"type": "string", "minLength": 1, "maxLength": 128},
        "confirm": {"type": "string", "description": "Ask the user first, in these words."},
        "submit": {"type": "boolean", "description": "Send the page's fields as values."}
      },
      "required": ["id"]
    },
    "Badge": {
      "type": "object",
      "properties": {
        "text": {"type": "string", "maxLength": 2000},
        "tone": {"$ref": "#/$defs/Tone"}
      },
      "required": ["text"]
    },
    "Choice": {
      "type": "object",
      "properties": {
        "value": {"type": "string"},
        "title": {"type": "string"}
      },
      "required": ["value"]
    },
    "ChartSeries": {
      "description": "One line, or one color of bars. No tone: the app's own colors, in order.",
      "type": "object",
      "properties": {
        "name": {"type": "string", "maxLength": 40},
        "tone": {"$ref": "#/$defs/Tone"},
        "points": {"type": "array", "minItems": 1, "maxItems": 120, "items": {"$ref": "#/$defs/ChartPoint"}}
      },
      "required": ["points"]
    },
    "ChartPoint": {
      "description": "A value at a label (a day, a model); display is how to write it (\"¥1.20\"), else the app writes value with the unit.",
      "type": "object",
      "properties": {
        "label": {"type": "string", "maxLength": 40},
        "value": {"type": "number"},
        "display": {"type": "string", "maxLength": 40}
      },
      "required": ["label", "value"]
    },
    "Stat": {
      "type": "object",
      "properties": {
        "label": {"type": "string", "minLength": 1},
        "value": {"type": "string", "minLength": 1},
        "detail": {"type": "string"},
        "tone": {"$ref": "#/$defs/Tone"}
      },
      "required": ["label", "value"]
    },
    "ActionResult": {
      "description": "What ui.action answers: a new view, a short message, an https link to open, or nothing (draw again).",
      "type": "object",
      "properties": {
        "view": {"$ref": "#/$defs/View"},
        "toast": {"type": "string"},
        "open_url": {"type": "string"}
      }
    },
    "PersonaCardKind": {"type": "string", "enum": ["stat", "stacked_bar", "line", "bar"]},
    "PersonaCard": {
      "description": "The assistant's ```persona-card block (#886): one JSON object. Joins the components in #1850; this form keeps drawing.",
      "type": "object",
      "properties": {
        "type": {"$ref": "#/$defs/PersonaCardKind"},
        "title": {"type": "string"},
        "subtitle": {"type": "string"},
        "value": {"type": "number", "x-go-pointer": true},
        "unit": {"type": "string"},
        "note": {"type": "string"},
        "total": {"$ref": "#/$defs/CardAmount"},
        "segments": {"type": "array", "items": {"$ref": "#/$defs/CardPart"}},
        "rest": {"$ref": "#/$defs/CardPart"},
        "points": {"type": "array", "items": {"$ref": "#/$defs/CardPart"}}
      },
      "required": ["type"]
    },
    "CardAmount": {
      "type": "object",
      "properties": {"value": {"type": "number"}, "unit": {"type": "string"}},
      "required": ["value"]
    },
    "CardPart": {
      "type": "object",
      "properties": {"label": {"type": "string"}, "value": {"type": "number"}, "note": {"type": "string"}},
      "required": ["label", "value"]
    }
  }
}
