# Copy to .env next to compose.yaml (docs/docker.md). Two lines to fill in; everything else has a default.

# The hub image, named after the repository: ghcr.io/<owner>/persona (before 0.1.2 it was ghcr.io/<owner>/jarvis).
JARVIS_IMAGE=ghcr.io/<owner>/persona:latest

# How phones reach the hub: this machine's LAN address with the port below, a VPN address, or an HTTPS reverse proxy
# in front of it. Left empty, the hub says so when it starts and pairing has no address until it is set (here, or on
# the admin page's network section).
JARVIS_PUBLIC_URL=http://nas.example.com:18660

# Who may open the hub's admin UI at <JARVIS_PUBLIC_URL>/admin (adding computers, devices, network; docs/admin.md):
#   loopback  only inside this container (docker compose exec): safest, least handy
#   lan       this machine and private addresses (inside a container the NAS's LAN cannot be told from other private
#             networks, so any private address counts), but never the bridge's gateway: Docker's userland proxy
#             relays from there, the internet included (Docker Desktop and OrbStack relay every browser so). The default
#   cidrs     this machine and the networks in JARVIS_ADMIN_CIDRS (e.g. your VPN's), comma separated
#   any       anyone over the hub's TLS port: only the admin password and its sign-in limits stand in the way
# Set here, it wins over hub.json and the admin page cannot change it. Left unset, the hub says so when it starts
# and uses hub.json's admin.access (lan when that is not set either). Setting the first admin password takes the
# one-time code in `docker compose logs hub` (or `docker compose exec hub personad hub admin setup-code`).
JARVIS_ADMIN_ACCESS=lan
# JARVIS_ADMIN_CIDRS=192.0.2.0/24,100.64.0.0/10

# Optional. Without them a first start makes up what it needs:
# The database's password. Unset: a random one on the first start, kept in data/docker/db-password. Set: letters and
# digits only (it goes into the database URL as it is), e.g. `openssl rand -hex 24`. Postgres takes it only when it
# first creates its data folder: changing it later locks the hub out (change it inside Postgres too,
# ALTER USER jarvis PASSWORD '...'). Deployments that already have one keep it here. Leaving it unset needs an image
# built with this compose.yaml or later: an older JARVIS_IMAGE tag cannot read the generated one, so set it then.
# JARVIS_DB_PASSWORD=
# The owner of the data folders (`id -u` / `id -g` of the NAS user that should own them). Unset: whoever owns the data
# folder next to compose.yaml (1000 when Docker made it itself).
# PUID=1000
# PGID=1000
# TZ=UTC
# The ports on this machine: the hub's (HTTP) and its TLS port. Keep the TLS one 18662 (that is the port the hub
# tells apps); put an address in front to publish it on one address only, e.g. <NAS LAN address>:18662.
# JARVIS_PORT=18660
# JARVIS_TLS_PORT=18662
# A private image: a token that can read it (GitHub: read:packages), so the hub can see when a newer image is out.
# JARVIS_REGISTRY_TOKEN=
# Docker Hub out of reach: postgres through a mirror or a local registry, e.g. <registry>/library/postgres:18-alpine
# JARVIS_POSTGRES_IMAGE=postgres:18-alpine
