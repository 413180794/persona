# Copy to .env next to compose.yaml and fill in (docs/docker.md). Keep .env private: it holds the database password.

# How phones reach the hub: a LAN address, a VPN address, or an HTTPS reverse proxy in front of the port below.
JARVIS_PUBLIC_URL=http://nas.example.com:18660

# The database's password: letters and digits only (it goes into the database URL as it is), e.g. the output of
# `openssl rand -hex 24`. Postgres takes it when it first creates its data folder: changing it here later locks the
# hub out (change it inside Postgres too, ALTER USER jarvis PASSWORD '...').
JARVIS_DB_PASSWORD=

# The owner of the data folders, as on the NAS (`id -u` / `id -g` of the user that should own them).
PUID=1000
PGID=1000

TZ=UTC

# Who may open the hub's admin UI at <JARVIS_PUBLIC_URL>/admin (adding computers, devices, network; docs/admin.md):
#   loopback  only inside this container (docker compose exec): safest, least handy
#   lan       this machine and private addresses (inside a container the NAS's LAN cannot be told from other private
#             networks, so any private address counts), but never the bridge's gateway: Docker's userland proxy
#             relays from there, the internet included (Docker Desktop and OrbStack relay every browser so). The default
#   cidrs     this machine and the networks in JARVIS_ADMIN_CIDRS (e.g. your VPN's), comma separated
#   any       anyone over the hub's TLS port (needs public.tls_listen and that port published): only the admin
#             password and its sign-in limits stand in the way
# Set here, it wins over hub.json and the admin page cannot change it. Left unset, the hub says so when it starts
# and uses hub.json's admin.access (lan when that is not set either).
JARVIS_ADMIN_ACCESS=lan
# JARVIS_ADMIN_CIDRS=192.0.2.0/24,100.64.0.0/10
# JARVIS_PORT=18660
# The hub image, named after the repository: ghcr.io/<owner>/persona (before 0.1.2 it was ghcr.io/<owner>/jarvis).
JARVIS_IMAGE=ghcr.io/<owner>/persona:latest
# A private image: a token that can read it (GitHub: read:packages), so the hub can see when a newer image is out.
# JARVIS_REGISTRY_TOKEN=
# Docker Hub out of reach: postgres through a mirror or a local registry, e.g. <registry>/library/postgres:18-alpine
# JARVIS_POSTGRES_IMAGE=postgres:18-alpine
