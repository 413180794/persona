[
  {
    "name": "mail_accounts",
    "description": "List the mail accounts the user has configured (name, address, provider). Call this before searching or sending mail so you know which account_id to use.",
    "input_schema": {
      "type": "object",
      "properties": {},
      "additionalProperties": false
    }
  },
  {
    "name": "mail_search",
    "description": "Search mail. Returns message summaries (uid, subject, from, date, snippet). Use account_id from mail_accounts; omit it to search every account's inbox at once. For Gmail the query uses Gmail search syntax (from:, subject:, has:attachment, newer_than:7d); other providers search the full text on their server. Some servers do not search at all (NetEase 163 finds nothing for any word): when the server finds nothing, subjects, senders and recipients are matched instead (every word must appear, case does not matter; bodies are not searched), a stretch of the newest mail at a time, and the result says which before_uid looks further back.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string",
          "description": "Account id from mail_accounts; omit to search all inboxes"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        },
        "query": {
          "type": "string",
          "description": "Search text or Gmail query"
        },
        "limit": {
          "type": "integer",
          "description": "Max results, default 20, max 200"
        },
        "before_uid": {
          "type": "integer",
          "description": "Return messages with UID lower than this, for paging"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "mail_read",
    "description": "Read one message in full: headers, plain text, HTML and the attachment list. Does not mark the message as read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "uid": {
          "type": "integer"
        },
        "mailbox": {
          "type": "string",
          "description": "Mailbox name, default INBOX"
        }
      },
      "required": [
        "account_id",
        "uid"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "mail_send",
    "description": "Send an email from one of the user's accounts. The user must approve each send on their phone before it goes out, so fill in a clear subject and body. To reply, pass in_reply_to with the original Message-ID and references with the original References chain plus that Message-ID.",
    "input_schema": {
      "type": "object",
      "properties": {
        "account_id": {
          "type": "string"
        },
        "to": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "cc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "bcc": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/address"
          }
        },
        "subject": {
          "type": "string"
        },
        "text": {
          "type": "string",
          "description": "Plain-text body"
        },
        "html": {
          "type": "string",
          "description": "Optional HTML body"
        },
        "in_reply_to": {
          "type": "string",
          "description": "Message-ID being replied to"
        },
        "references": {
          "type": "string",
          "description": "Space-separated Message-IDs from the original thread"
        }
      },
      "required": [
        "account_id",
        "to",
        "subject",
        "text"
      ],
      "$defs": {
        "address": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "email": {
              "type": "string"
            }
          },
          "required": [
            "email"
          ]
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "ask_user",
    "description": "Ask the user one or more multiple-choice questions on their iPhone (a card in this conversation plus a push notification) and wait for the answers. Use it to confirm anything risky (sending messages / email for them, deleting, changing live systems) or to let them pick between options. AskUserQuestion does not work here; use this instead. The user can also type a free-form answer. Waits up to 30 minutes.",
    "input_schema": {
      "type": "object",
      "required": [
        "questions"
      ],
      "properties": {
        "questions": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "type": "object",
            "required": [
              "question",
              "options"
            ],
            "properties": {
              "question": {
                "type": "string"
              },
              "header": {
                "type": "string",
                "description": "short label, ≤12 chars"
              },
              "multiSelect": {
                "type": "boolean"
              },
              "options": {
                "type": "array",
                "minItems": 2,
                "maxItems": 4,
                "items": {
                  "type": "object",
                  "required": [
                    "label"
                  ],
                  "properties": {
                    "label": {
                      "type": "string"
                    },
                    "description": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "notify_user",
    "description": "Send the user a push notification right now (works when the app is closed). Tapping it opens this conversation. Use for results of scheduled runs and anything time-sensitive; don't notify for ordinary replies (they get one automatically).",
    "input_schema": {
      "type": "object",
      "required": [
        "title",
        "body"
      ],
      "properties": {
        "title": {
          "type": "string"
        },
        "body": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "schedule_followup",
    "description": "Wake yourself up later: at the given time Persona sends `prompt` into this conversation (or a new one) as if the user wrote it, you do the work, and the user gets a push with your answer (with `push: \"asked\"`, only what you send with notify_user). Use for \"remind me…\", \"check again in an hour\", meeting prep 10 minutes before a meeting, watching something until it changes. `at` is RFC 3339 (2026-10-27T09:50:00+08:00) or relative (\"30m\", \"2h\", \"1d\"). For something to do again and again (a patrol every 30 minutes) pass `every` (\"30m\", \"2h\", at least 5m) once: Persona repeats it by itself and the user sees, edits and stops it in the app; never schedule the next run from inside a run. Which model and permission mode a task runs with is the user's choice in the app.",
    "input_schema": {
      "type": "object",
      "required": [
        "prompt"
      ],
      "properties": {
        "at": {
          "type": "string",
          "description": "when (the first run, with every); default with every: one interval from now"
        },
        "every": {
          "type": "string",
          "description": "repeat this often, e.g. 30m"
        },
        "prompt": {
          "type": "string",
          "description": "what to do then, self-contained"
        },
        "title": {
          "type": "string",
          "description": "short label shown in the app"
        },
        "new_conversation": {
          "type": "boolean",
          "description": "start a fresh conversation instead of continuing this one"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something (it then runs in its own conversation, not this one). Omit to keep an existing task's"
        }
      }
    }
  },
  {
    "name": "schedule_routine",
    "description": "Set up a recurring routine: every day (or on some weekdays) at a time, Persona starts a new conversation with `prompt`, you do the work, and the user gets a push with your answer (with `push: \"asked\"`, only what you send with notify_user). Use for \"每天 9 点给我早报\", \"每周五下午起草周报\". For one-off reminders use schedule_followup. Pass `id` (from list_followups) to change an existing routine: only the fields you give change; `enabled: false` pauses it. Times are in the user's time zone.",
    "input_schema": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "description": "to change an existing routine"
        },
        "title": {
          "type": "string",
          "description": "short name shown in the app, e.g. 早报"
        },
        "prompt": {
          "type": "string",
          "description": "what to do each time, self-contained"
        },
        "time": {
          "type": "string",
          "description": "HH:MM, 24-hour"
        },
        "weekdays": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 7
          },
          "description": "1 = Monday … 7 = Sunday; omit or empty = every day"
        },
        "enabled": {
          "type": "boolean"
        },
        "push": {
          "type": "string",
          "enum": [
            "every",
            "asked"
          ],
          "description": "every (default for a new task): each run's answer is pushed to the user; asked: only what a run sends with notify_user, for a task that watches something (it then runs in its own conversation). Omit to keep an existing task's"
        }
      }
    }
  },
  {
    "name": "delete_routine",
    "description": "Delete a scheduled task (routine or follow-up) by id (from list_followups). Confirm with the user first unless they asked for it.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "list_followups",
    "description": "List every scheduled task (with ids): follow-ups that have not run yet, repeating ones, daily routines.",
    "input_schema": {
      "type": "object",
      "properties": {}
    }
  },
  {
    "name": "cancel_followup",
    "description": "Cancel a scheduled follow-up or a repeating task by id (from list_followups).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "agents_list",
    "description": "The Claude Code / Codex agents running on the user's computers (herdr), with their state: needs_you (waiting for an answer / approval), working, unread (finished, result not looked at), idle. Each line has machine, session id, project, title, last update and the last thing the agent said. Much faster and more accurate than ssh + herdr.\n\nA line under an agent is something waiting for the user: a question lists its options and the interaction id to answer it with (interaction_answer), an approval is the user's to give in the app.",
    "input_schema": {
      "type": "object",
      "properties": {
        "state": {
          "type": "string",
          "enum": [
            "active",
            "needs_you",
            "working",
            "unread",
            "idle",
            "all"
          ],
          "description": "default active = needs_you + working + unread"
        },
        "machine": {
          "type": "string"
        },
        "query": {
          "type": "string",
          "description": "filter by title / project / directory"
        }
      }
    }
  },
  {
    "name": "agent_read",
    "description": "Read the recent conversation of one agent (from agents_list): the user's messages, what the agent said, tool calls in short form. `turns` = how many recent exchanges (default 2, max 10).",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "agent_send",
    "description": "Send a message to an agent as the user would type it (answers its question, tells it to continue, gives new instructions). Queued if the agent is working. Only send what the user asked for. An agent that is not running any more (a finished task's agent is closed after a few idle minutes) is resumed first, in the same session with the same machine, directory and launcher, so you can keep working with it.\n\nWhen a dialog holds the agent's terminal the send is refused (dialog_open) with the dialog's first line, and whether it is only a notice that Enter closes (\"Enter to continue\", no options). Send again with dismiss_notice true to close such a notice first. Confirmations, permissions and pickers are never closed for you: tell the user, or answer them with interaction_answer.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "text"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "session_id": {
          "type": "string"
        },
        "text": {
          "type": "string"
        },
        "dismiss_notice": {
          "type": "boolean",
          "description": "Press Enter first to close a notice that only says \"Enter to continue\" (no options). Any other dialog still refuses the send."
        }
      }
    }
  },
  {
    "name": "agent_start",
    "description": "Start a new Claude Code agent in herdr on one of the user's computers, in a project directory, with a first prompt. Use for real development work instead of doing it here. Returns the new session id.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "cwd",
        "prompt"
      ],
      "properties": {
        "machine": {
          "type": "string"
        },
        "cwd": {
          "type": "string",
          "description": "absolute path or ~/…"
        },
        "prompt": {
          "type": "string"
        },
        "launcher": {
          "type": "string",
          "description": "shell command that starts claude (default: the machine's default)"
        }
      }
    }
  },
  {
    "name": "interaction_answer",
    "description": "Answer another agent's question for the user, in their place, when they said what to answer or told you to decide. Only a question can be answered this way: a tool permission, a plan and a terminal dialog are theirs to decide in the app, and the assistant's own question is never answered by itself. Every question must be answered by its own wording, with the option labels it offers; free text is not accepted (the user answers that in the app, or you use agent_send). A multi-select takes an array of labels.",
    "input_schema": {
      "type": "object",
      "required": [
        "machine",
        "session_id",
        "interaction_id",
        "answers"
      ],
      "properties": {
        "machine": {
          "type": "string",
          "description": "the machine's id or name, as agents_list shows it"
        },
        "session_id": {
          "type": "string",
          "description": "the agent's session id, or its first 8 characters"
        },
        "interaction_id": {
          "type": "string",
          "description": "the waiting interaction's id, from agents_list"
        },
        "answers": {
          "type": "object",
          "description": "each question's own wording → the option label to pick; a multi-select gives an array of labels",
          "additionalProperties": {
            "oneOf": [
              {
                "type": "string"
              },
              {
                "type": "array",
                "items": {
                  "type": "string"
                }
              }
            ]
          }
        }
      }
    }
  },
  {
    "name": "inbox_draft",
    "description": "Submit the reply you drafted for the inbox item this conversation was started for. It waits in the user's inbox; they read it and send it with one tap (you never send it yourself). `text` is the reply in the user's voice, ready to go out as it is: no blanks to fill in (【…】) — leave out what you could not find and say so in `note`; `note` is one or two sentences on what you found and where, for the user to check the draft against. For a Feishu sheet / Base item, `changes` proposes moving rows' status (ref, field and one of the values the item lists); they are made when the user sends. Call it once, at the end.",
    "input_schema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "ref",
              "field",
              "value"
            ],
            "properties": {
              "ref": {
                "type": "string"
              },
              "field": {
                "type": "string"
              },
              "value": {
                "type": "string"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "kb_search",
    "description": "Search the knowledge base (~/.jarvis/data): summaries and metadata of chats, people, projects, docs, meetings, events, project timelines, the notes directories the user added (hits with an absolute path) and, with messages=true, the full message archive (newest days first). All words must match.",
    "input_schema": {
      "type": "object",
      "required": [
        "query"
      ],
      "properties": {
        "query": {
          "type": "string"
        },
        "messages": {
          "type": "boolean",
          "description": "also search the message archive (default true)"
        },
        "limit": {
          "type": "integer",
          "description": "default 40"
        }
      }
    }
  },
  {
    "name": "kb_list",
    "description": "List knowledge-base entities of one kind ranked by importance (P0 first), relevance to the user, recency: projects (short = a feature / launch, long = a team mission), chats, people, docs, meetings, events. Optional tag filter.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events"
          ]
        },
        "tag": {
          "type": "string"
        },
        "limit": {
          "type": "integer",
          "description": "default 30"
        }
      }
    }
  },
  {
    "name": "kb_get",
    "description": "Read one entity: its metadata (links to people / chats / projects, tags), compressed context (summary.md), a project's timeline, a chat's messages of the last 7 days. id from kb_list / kb_search (a project also by name).",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events"
          ]
        },
        "id": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "kb_update",
    "description": "Write to the knowledge base: create or change a project (name, project_kind short|long, status, goal, my_role, aliases, link chats / people, code dirs as \"\u003cmachine\u003e:\u003cpath\u003e\" so Agents there belong to it, append a timeline `log` line, replace its summary), or tag / annotate a chat, person, doc, meeting, event (importance P0–P3, relevance 0–100, tags, note, link projects). Tags set here are kept over the automatic ones. Use it whenever a conversation settles something about a project or person. Two projects that are the same work under two names: `merge_into`.",
    "input_schema": {
      "type": "object",
      "required": [
        "kind",
        "id"
      ],
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "projects",
            "chats",
            "people",
            "docs",
            "meetings",
            "events"
          ]
        },
        "id": {
          "type": "string",
          "description": "id, or a project's name (created when new)"
        },
        "merge_into": {
          "type": "string",
          "description": "projects only: fold this project into that one (slug or name) when they are the same work; nothing else is changed in the same call"
        },
        "name": {
          "type": "string"
        },
        "project_kind": {
          "type": "string",
          "enum": [
            "short",
            "long"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "active",
            "paused",
            "done"
          ]
        },
        "goal": {
          "type": "string"
        },
        "my_role": {
          "type": "string"
        },
        "note": {
          "type": "string"
        },
        "importance": {
          "type": "string",
          "enum": [
            "P0",
            "P1",
            "P2",
            "P3"
          ]
        },
        "relevance": {
          "type": "integer"
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "summary": {
          "type": "string",
          "description": "Markdown, replaces summary.md"
        },
        "log": {
          "type": "string",
          "description": "one line appended to a project's timeline"
        },
        "aliases": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "chats": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "people": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dirs": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "projects": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    }
  },
  {
    "name": "jarvis_settings",
    "description": "Read and change Persona's own settings for the user: their inbox sorting rules, the AI 分身's rules, 关于我 (what you know about them), your default launcher (model), their mail accounts, which Claude Code config directories each machine keeps out of Agents. Start with action list (what there is, what each takes); get reads one. set / add / remove put a card on the user's phone that says what changes (before → after) and nothing changes until they approve; what the card needs filled in, like a mail password, the user types there, so never ask for passwords in the conversation. Change only what the user asked for.",
    "input_schema": {
      "type": "object",
      "properties": {
        "action": {
          "type": "string",
          "enum": [
            "list",
            "get",
            "set",
            "add",
            "remove"
          ],
          "description": "default list"
        },
        "key": {
          "type": "string",
          "description": "the setting, from list (inbox.rules, mail.accounts…)"
        },
        "value": {
          "description": "set: the new value; add: the item (each setting's list entry says what)"
        },
        "id": {
          "type": "string",
          "description": "remove: which item (from get)"
        }
      },
      "additionalProperties": false
    }
  },
  {
    "name": "conversations_list",
    "description": "List Persona's own conversations (the 对话 sidebar), newest activity first: id, title, last activity, whether it is the main conversation, whether it is running now, and the gist of its last message. Archived ones are left out unless `include_archived`. This conversation is marked. Use it to find a conversation the user means (\"the one about the trip\") before reading, renaming, archiving or messaging it.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "only conversations whose title or last message contains this (case-insensitive)"
        },
        "include_archived": {
          "type": "boolean",
          "description": "also list archived conversations (marked as such)"
        },
        "limit": {
          "type": "integer",
          "description": "how many (default 30, max 100)"
        }
      }
    }
  },
  {
    "name": "conversation_read",
    "description": "Read the recent part of another Persona conversation (an id from conversations_list): the user's messages, what was answered, tool calls in short form, cut like agent_read. `turns` = how many recent exchanges (default 2, max 10).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "turns": {
          "type": "integer"
        }
      }
    }
  },
  {
    "name": "conversation_rename",
    "description": "Rename a Persona conversation. Titles read 「MMDD | 类型 | 主题」: give `kind` and `topic` and the hub puts the day the conversation started in front. A title the user gave stays: renaming one fails unless the user asked for this rename in so many words (then pass `user_asked`). The main conversation has no title to change.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "kind",
        "topic"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters; this conversation's own id renames it"
        },
        "kind": {
          "type": "string",
          "enum": [
            "功能",
            "设计",
            "修复",
            "优化",
            "发布",
            "探索",
            "文档",
            "研究",
            "评审",
            "定时"
          ]
        },
        "topic": {
          "type": "string",
          "description": "what it is about, at most 14 characters"
        },
        "user_asked": {
          "type": "boolean",
          "description": "the user asked for this rename; needed to replace a title they gave"
        }
      }
    }
  },
  {
    "name": "conversation_archive",
    "description": "Archive a Persona conversation: it leaves the sidebar's list (it is kept, and listed under 已归档), nothing is deleted. Only when the user asks to tidy up or archive. The main conversation can't be archived. Archiving this conversation itself is allowed: the current turn finishes, and a new message from the user brings it back.",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "conversation_unarchive",
    "description": "Bring an archived Persona conversation back into the sidebar's list (find it with conversations_list and include_archived).",
    "input_schema": {
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        }
      }
    }
  },
  {
    "name": "conversation_new",
    "description": "Start a new Persona conversation with an opening message and return its id at once (it does not wait for the answer). For work that deserves its own thread, when the user asks for one. The message arrives marked as coming from this conversation; it is named after its first turn like any new conversation.",
    "input_schema": {
      "type": "object",
      "required": [
        "text"
      ],
      "properties": {
        "text": {
          "type": "string",
          "description": "the opening message: everything the new conversation needs, it does not see this one"
        }
      }
    }
  },
  {
    "name": "conversation_send",
    "description": "Send a message to another Persona conversation (not this one). If it is running, the message waits until its current turn ends. The message arrives marked as coming from this conversation, so the other side can answer with conversation_send. Conversations passing messages back and forth are limited (a few hops from the user's message, a few messages per pair in ten minutes): don't reply just to acknowledge.",
    "input_schema": {
      "type": "object",
      "required": [
        "id",
        "text"
      ],
      "properties": {
        "id": {
          "type": "string",
          "description": "full id or its first 8 characters"
        },
        "text": {
          "type": "string"
        }
      }
    }
  },
  {
    "name": "task_plan",
    "description": "Hand the user a plan of one or more tasks for agents on their computers, instead of starting agents yourself. Use it for any work that takes an agent (code, research in a repo, anything longer than a few tool calls); one task per independent piece of work. Fill in every field from what you know (the knowledge base, agents_list: which machine works in which directory, the user's habits); the user sees each choice as a chip they can change, with your one-line reason. Read-only tasks, tasks the user asked for themselves (user_requested), and kinds the user told you to start without asking, start at once; the rest wait as a card for the user's 开始. Either way this returns at once: don't wait, carry on. Each started task is a todo (todo id) whose progress shows in your context snapshot; send to a task's agent with agent_send. Quick things you can do with a tool yourself (a reminder, an event) are not tasks.",
    "input_schema": {
      "type": "object",
      "required": [
        "tasks"
      ],
      "properties": {
        "tasks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 8,
          "items": {
            "type": "object",
            "required": [
              "title",
              "prompt",
              "machine",
              "cwd",
              "readonly",
              "user_requested",
              "why"
            ],
            "properties": {
              "title": {
                "type": "string",
                "description": "the task in a short line the user reads on the card (Chinese, under 20 characters)"
              },
              "prompt": {
                "type": "string",
                "description": "the agent's first message: everything it needs to do the task without asking you"
              },
              "machine": {
                "type": "string",
                "description": "machine id"
              },
              "cwd": {
                "type": "string",
                "description": "the project directory: absolute path or ~/…"
              },
              "launcher": {
                "type": "string",
                "description": "launcher name; empty: the default"
              },
              "model": {
                "type": "string",
                "description": "model; empty: the launcher's default"
              },
              "permission": {
                "type": "string",
                "enum": [
                  "default",
                  "acceptEdits",
                  "plan",
                  "bypassPermissions"
                ],
                "description": "permission mode; empty: the default"
              },
              "readonly": {
                "type": "boolean",
                "description": "true when the task only reads (looks things up, reads code, writes nothing anywhere)"
              },
              "user_requested": {
                "type": "boolean",
                "description": "true when the user asked for this very task in their latest message (told you to do it, to have an agent do it, to go ahead and start); false when it is your own idea or inferred from something they did not ask for"
              },
              "why": {
                "type": "string",
                "description": "one line (Chinese) on why this machine, directory and model"
              }
            }
          }
        }
      }
    }
  },
  {
    "name": "github_search",
    "description": "Search GitHub as the user (their gh login on one of their machines). kind \"issues\" (default) finds issues and pull requests with GitHub's search syntax, e.g. \"is:pr is:open review-requested:@me\", \"involves:@me is:open updated:\u003e2026-01-01\", \"repo:owner/name label:bug\"; add involves:@me unless the user asked about something wider. kind \"code\" searches code (\"repo:owner/name symbol\"). Returns one line per result with its repo#number, state, title, author, last update and URL; read one with github_read.",
    "input_schema": {
      "type": "object",
      "properties": {
        "query": {
          "type": "string",
          "description": "GitHub search query"
        },
        "kind": {
          "type": "string",
          "enum": [
            "issues",
            "code"
          ],
          "description": "issues (issues and pull requests, the default) or code"
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 50,
          "description": "How many results (default 20)"
        }
      },
      "required": [
        "query"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_read",
    "description": "Read one GitHub pull request or issue: title, state, author, labels, the description, and for a pull request its branches, merge state, requested reviewers and reviews; then its comments, newest first (long texts are cut). Use github_diff for what a pull request changes and github_checks for its CI.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The issue or pull request number"
        },
        "comments": {
          "type": "integer",
          "minimum": 0,
          "maximum": 50,
          "description": "How many of the newest comments and reviews to include (default 15)"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_diff",
    "description": "What a GitHub pull request changes. Without path: every changed file with its status and lines added / removed. With path: that file's patch (cut when very long; a file too big for GitHub to show has only its counts).",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The pull request number"
        },
        "path": {
          "type": "string",
          "description": "One changed file's path, for its patch"
        }
      },
      "required": [
        "repo",
        "number"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_checks",
    "description": "The checks (CI) of a GitHub pull request's head commit, or of a commit / branch: each check's name, status and conclusion. For failed GitHub Actions jobs it adds the last part of the job's log, where the error usually is.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "A pull request number (its head commit is checked)"
        },
        "ref": {
          "type": "string",
          "description": "A commit SHA or branch name, instead of number"
        }
      },
      "required": [
        "repo"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_comment",
    "description": "Comment on a GitHub pull request or issue as the user. Everyone who can see the repository sees it (for a public repository, everyone), so the user approves each comment on their phone before it is posted, unless their rules allow it. Write what the user would write; never post on your own initiative what they have not asked for.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The issue or pull request number"
        },
        "body": {
          "type": "string",
          "description": "The comment, Markdown"
        }
      },
      "required": [
        "repo",
        "number",
        "body"
      ],
      "additionalProperties": false
    }
  },
  {
    "name": "github_review",
    "description": "Submit a review on a GitHub pull request as the user: approve it, request changes, or comment. The user approves it on their phone first (an approval says so in bold), unless their rules allow it. Only approve when the user has said to.",
    "input_schema": {
      "type": "object",
      "properties": {
        "repo": {
          "type": "string",
          "description": "owner/name"
        },
        "number": {
          "type": "integer",
          "description": "The pull request number"
        },
        "event": {
          "type": "string",
          "enum": [
            "APPROVE",
            "REQUEST_CHANGES",
            "COMMENT"
          ],
          "description": "APPROVE, REQUEST_CHANGES (body required) or COMMENT (body required)"
        },
        "body": {
          "type": "string",
          "description": "The review's text, Markdown"
        }
      },
      "required": [
        "repo",
        "number",
        "event"
      ],
      "additionalProperties": false
    }
  }
]
